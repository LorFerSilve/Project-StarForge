{
  "version": 10,
  "cmakeMinimumRequired": { "major": 4, "minor": 3, "patch": 3 },
  "configurePresets": [
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_FEATURES": "tests;runtime",
        "STARFORGE_BUILD_TESTS": "ON",
        "STARFORGE_BUILD_DEVTOOLS": "OFF",
        "STARFORGE_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "windows-msvc-relwithdebinfo",
      "displayName": "Windows MSVC RelWithDebInfo",
      "inherits": "windows-msvc-debug",
      "binaryDir": "${sourceDir}/out/build/${presetName}"
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux Clang 23 Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "clang++-23",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_FEATURES": "tests;runtime",
        "STARFORGE_BUILD_TESTS": "ON",
        "STARFORGE_BUILD_DEVTOOLS": "OFF",
        "STARFORGE_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc-debug", "configurePreset": "windows-msvc-debug", "configuration": "Debug" },
    { "name": "windows-msvc-relwithdebinfo", "configurePreset": "windows-msvc-relwithdebinfo", "configuration": "RelWithDebInfo" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" }
  ],
  "testPresets": [
    { "name": "windows-unit", "configurePreset": "windows-msvc-debug", "configuration": "Debug", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "unit" } } },
    { "name": "windows-domain", "configurePreset": "windows-msvc-debug", "configuration": "Debug", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "domain" } } },
    { "name": "windows-content", "configurePreset": "windows-msvc-debug", "configuration": "Debug", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "content" } } },
    { "name": "windows-persistence", "configurePreset": "windows-msvc-debug", "configuration": "Debug", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "persistence" } } },
    { "name": "windows-backends", "configurePreset": "windows-msvc-debug", "configuration": "Debug", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "backends" } } },
    { "name": "linux-unit", "configurePreset": "linux-clang-debug", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "unit" } } },
    { "name": "linux-domain", "configurePreset": "linux-clang-debug", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "domain" } } },
    { "name": "linux-content", "configurePreset": "linux-clang-debug", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "content" } } },
    { "name": "linux-persistence", "configurePreset": "linux-clang-debug", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "persistence" } } },
    { "name": "linux-backends", "configurePreset": "linux-clang-debug", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "backends" } } }
  ]
}
